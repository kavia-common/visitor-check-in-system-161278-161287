# Copy this file to ".env" in the same directory and set the URL to your deployed visitor form.
# The app will use this value to generate the QR code.
# If not set, the app falls back to http://localhost:3000
#
# Example of a deployed URL:
# VISITOR_FORM_URL=https://your-domain.example.com/visitor-form

VISITOR_FORM_URL=http://localhost:3000
